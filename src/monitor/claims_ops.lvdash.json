{
 "datasets": [
  {
   "name": "ds_usage",
   "displayName": "Usage",
   "queryLines": [
    "SELECT event_time, date_trunc('HOUR', event_time) AS hour, coalesce(request_tags['step'], 'untagged') AS step,\n",
    " CASE WHEN status_code = 200 AND destination_model IS NULL THEN 'Blocked by policy' WHEN status_code = 200 THEN 'Answered' ELSE 'Error' END AS outcome,\n",
    " coalesce(destination_model, 'none') AS model, coalesce(input_tokens, 0) AS input_tokens, coalesce(output_tokens, 0) AS output_tokens, coalesce(input_tokens, 0) + coalesce(output_tokens, 0) AS total_tokens,\n",
    " latency_ms, CASE WHEN status_code = 200 AND destination_model IS NULL THEN 1 ELSE 0 END AS blocked\n",
    "FROM system.ai_gateway.usage WHERE service_name = 'e2e_ai_workshop_catalog.agent.claims_llm'\n"
   ]
  },
  {
   "name": "ds_quality",
   "displayName": "Quality",
   "queryLines": [
    "SELECT t.trace_id, date_trunc('HOUR', t.request_time) AS hour, a.assessment_name AS judge,\n",
    " CASE WHEN lower(a.feedback.value) IN ('yes', 'true', '\"yes\"', '\"true\"') THEN 1.0 ELSE 0.0 END AS passed\n",
    "FROM e2e_ai_workshop_catalog.ops.claims_agent_trace_unified t LATERAL VIEW explode(t.assessments) x AS a\n",
    "WHERE a.feedback.value IS NOT NULL AND a.assessment_name IN ('correctness', 'coverage_accuracy', 'safety', 'cites_policy_section', 'retrieval_groundedness', 'safety_monitor', 'cites_sources_monitor')\n"
   ]
  },
  {
   "name": "ds_traces",
   "displayName": "Traces",
   "queryLines": [
    "SELECT trace_id, request_time, date_trunc('HOUR', request_time) AS hour, state, execution_duration_ms / 1000.0 AS seconds\n",
    "FROM e2e_ai_workshop_catalog.ops.claims_agent_trace_unified\n"
   ]
  },
  {
   "name": "ds_dq",
   "displayName": "Dq",
   "queryLines": [
    "SELECT e.timestamp AS ts, x.dataset AS dataset_name, x.name AS expectation, x.passed_records AS passed, x.failed_records AS failed,\n",
    " x.passed_records / greatest(x.passed_records + x.failed_records, 1) AS pass_rate\n",
    "FROM event_log('1abf00a9-7a44-46a1-a3ff-58cbc867991c') e\n",
    "LATERAL VIEW explode(from_json(e.details:flow_progress.data_quality.expectations::string, 'array<struct<name:string,dataset:string,passed_records:bigint,failed_records:bigint>>')) t AS x\n",
    "WHERE e.event_type = 'flow_progress' AND e.details:flow_progress.data_quality.expectations IS NOT NULL\n",
    "QUALIFY row_number() OVER (PARTITION BY x.dataset, x.name ORDER BY e.timestamp DESC) = 1\n"
   ]
  },
  {
   "name": "ds_claims",
   "displayName": "Claims",
   "queryLines": [
    "SELECT claim_id, status, loss_type, claim_amount, loss_date FROM claims\n"
   ]
  }
 ],
